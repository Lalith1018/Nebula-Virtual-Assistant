# Copy this file to .env and fill in your keys

# OpenWeatherMap — free key at https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_key_here

# Spotify — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Anthropic — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: n8n webhook base URL (default: http://localhost:5678/webhook/)
# N8N_BASE_URL=http://localhost:5678/webhook/
